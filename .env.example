# =============================================================================
# MediVault AI — Environment Variables Template
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Postgres (shared primary DB) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medivault
POSTGRES_USER=medivault_user
POSTGRES_PASSWORD=CHANGE_ME

# --- Auth Service ---
AUTH_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File / Report Storage ---
# In dev: local disk path. In prod: S3-compatible bucket URL.
STORAGE_BACKEND=local                      # "local" | "s3"
STORAGE_LOCAL_PATH=./data/uploads          # only used when STORAGE_BACKEND=local
STORAGE_S3_BUCKET=                         # only used when STORAGE_BACKEND=s3
STORAGE_S3_ENDPOINT=                       # leave blank for AWS; set for MinIO/other
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- AI Service ---
# Sentence embedding model (HuggingFace model name or local path)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OCR: path to Tesseract binary (Linux: /usr/bin/tesseract, Windows: adjust)
TESSERACT_CMD=/usr/bin/tesseract

# --- Service internal URLs (used by the BFF/api to route to services) ---
AUTH_SERVICE_URL=http://auth-service:8001
HEALTH_SERVICE_URL=http://health-service:8002
AI_SERVICE_URL=http://ai-service:8003

# --- Logging ---
LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR
