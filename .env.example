# =============================================================================
# MediVault AI — Environment Variables Template
# Copy to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medivault
POSTGRES_USER=medivault_user
POSTGRES_PASSWORD=CHANGE_ME

# --- Auth / JWT (BFF and auth-service must share this secret) ---
AUTH_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Internal service-to-service key (health → AI) ---
# When set, AI /parse and /anomaly/detect require header X-Internal-Key.
INTERNAL_SERVICE_KEY=dev-internal-key-change-me

# --- File / Report Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# --- AI Service ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TESSERACT_CMD=tesseract
# 1 = BM25+intent KB at startup (recommended for live demo; no HF download)
# 0 + MEDIVAULT_USE_DENSE=1 = try MiniLM hybrid (may stall on first boot)
MEDIVAULT_FAST_KB=1
MEDIVAULT_USE_DENSE=0

# --- ML feature flags (all OFF = current rule-based / statistical path) ---
# Flip only after models/*/evaluate.py passes validation checkpoints.
# See docs/ml-migration-plan.md and docs/ml-pipeline.md.
USE_UNLIMITED_OCR=0
USE_ML_NORMALIZER=0
# Phase 2 normalizer backends (only matter when USE_ML_NORMALIZER=1)
# char_tfidf (default offline) | modernbert | clinicalbert
NORMALIZER_BACKEND=char_tfidf
NORMALIZER_ALLOW_HF=0
NORMALIZER_MIN_CONFIDENCE=0.55
# NORMALIZER_ARTIFACTS_DIR=
# MODERNBERT_MODEL_ID=answerdotai/ModernBERT-base
# CLINICALBERT_MODEL_ID=emilyalsentzer/Bio_ClinicalBERT
USE_RISK_MODEL=0
# Phase 4 alias (same effect as USE_RISK_MODEL)
USE_DISEASE_RISK_MODEL=0
# auto | xgboost | lightgbm | logistic | sklearn_gb
RISK_MODEL_BACKEND=auto
# Phase 5 — longitudinal biomarker forecasting (default off)
USE_FORECAST_MODEL=0
# auto | lightgbm | xgboost | linear | sklearn_gb | lstm | temporal_transformer
FORECAST_MODEL_BACKEND=auto
# FORECAST_HORIZON_DAYS=180
# FORECAST_ARTIFACTS_DIR=
USE_EMBEDDING_SEARCH=0
# Phase 3 semantic retrieval (only when USE_EMBEDDING_SEARCH=1)
# auto | bge | minilm | char_tfidf
RETRIEVAL_EMBEDDING_BACKEND=auto
RETRIEVAL_VECTOR_STORE=faiss
RETRIEVAL_ALLOW_HF=0
# RETRIEVAL_ARTIFACTS_DIR=
# BGE_MODEL_ID=BAAI/bge-small-en-v1.5
# MINILM_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
USE_HEALTH_SCORE_MODEL=0
# auto | xgboost | lightgbm | linear | sklearn_gb
HEALTH_SCORE_BACKEND=auto
# HEALTH_SCORE_ARTIFACTS_DIR=
# Phase 7 — unsupervised lab anomaly detection (default off)
USE_ANOMALY_MODEL=0
# Phase 0 alias (same effect as USE_ANOMALY_MODEL)
USE_OUTLIER_MODEL=0
# auto | isolation_forest | lof | robust_z | autoencoder | ocsvm
ANOMALY_MODEL_BACKEND=auto
# ANOMALY_CONTAMINATION=0.08
# ANOMALY_ARTIFACTS_DIR=
USE_IMAGE_QUALITY_MODEL=0
# auto | mobilenet_v3 | efficientnet_lite0 | opencv_rules | feature_ml
IMAGE_QUALITY_BACKEND=auto
# IMAGE_QUALITY_ARTIFACTS_DIR=

# --- Unlimited-OCR (only when USE_UNLIMITED_OCR=1) ---
# PRODUCTION DEFAULT: USE_UNLIMITED_OCR=0 (legacy parser)
# auto = HTTP endpoint only when set; never auto-loads multi-GB local weights (Phase 1A)
# http | local | stub
UNLIMITED_OCR_BACKEND=auto
UNLIMITED_OCR_ENDPOINT=
# Explicit opt-in required for local HF weights (prevents hang/OOM)
UNLIMITED_OCR_ALLOW_LOCAL_WEIGHTS=0
# Explicit opt-in for downloading missing weights (local_files_only when 0)
UNLIMITED_OCR_ALLOW_LOCAL_DOWNLOAD=0
UNLIMITED_OCR_HF_MODEL=baidu/Unlimited-OCR
UNLIMITED_OCR_TIMEOUT_S=120
UNLIMITED_OCR_DEVICE=auto
# Treat empty laboratory extraction as failure → legacy fallback (recommended 1)
UNLIMITED_OCR_EMPTY_AS_FAILURE=1
# After changing flags: restart ai-service (registry cache)
# --- Service URLs ---
# Local processes (default for hackathon laptop demo):
AUTH_SERVICE_URL=http://127.0.0.1:8001
HEALTH_SERVICE_URL=http://127.0.0.1:8002
AI_SERVICE_URL=http://127.0.0.1:8003
# Docker Compose service DNS (override when running in compose):
# AUTH_SERVICE_URL=http://auth-service:8001
# HEALTH_SERVICE_URL=http://health-service:8002
# AI_SERVICE_URL=http://ai-service:8003

# --- BFF CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Optional experiment tracking (Phase 9; default OFF) ---
# When off, train/eval scripts run without MLflow/W&B side effects.
ML_EXPERIMENT_TRACKING=0
# none | mlflow | wandb
ML_EXPERIMENT_BACKEND=none
# MLFLOW_TRACKING_URI=http://127.0.0.1:5000
# MLFLOW_EXPERIMENT_NAME=medivault-ml
# WANDB_PROJECT=medivault-ml
# WANDB_MODE=offline
