# MediVault — .gitignore
# Ignore build artifacts, secrets, IDE/agent tooling, and large ML weights.
# Keep source, docs, synthetic fixtures, and configs tracked.

# --- Secrets & local env ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
pip-wheel-metadata/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.junit.xml
.tox/
.nox/

# --- Node / frontend ---
node_modules/
.npm/
.next/
.nuxt/
out/
apps/**/dist/
apps/web/dist/
apps/research-site/dist/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# --- Cursor / AI coding tooling (never commit) ---
.cursor/
.cursorignore
.cursorrules
.aider*
.claude/
.codex/
.continue/
*.code-workspace
agent-transcripts/
.agents/

# --- Logs & local scratch ---
*.log
logs/
*_logs/
phase*_logs/
tmp/
temp/
*.tmp

# --- Local ops reports (machine-specific) ---
PUSH_READINESS.md
POST_PUSH_VERIFICATION.md

# --- Docker local overrides ---
docker-compose.override.yml

# --- ML artifacts & caches (store externally; regenerate via train) ---
models/**/artifacts/
*.bin
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
.cache/
.huggingface/
mlruns/
wandb/
.mlflow/

# --- Dataset blobs (keep README / small JSONL fixtures) ---
data/datasets/*.csv
data/datasets/*.parquet
data/datasets/*.pkl
data/knowledge-base/*.pdf
datasets/**/*.csv
datasets/**/*.parquet
datasets/**/*.pkl
datasets/**/*.zip
!datasets/**/.gitkeep
!datasets/**/README.md
!datasets/**/LICENSING.md

# Regenerated eval / train reports (local only)
datasets/evaluation/*_latest.json
datasets/evaluation/safe_train_*.json
data/datasets/plan_c/results_latest.json

# --- Research site deploy metadata ---
apps/research-site/.vercel
.vercel/
